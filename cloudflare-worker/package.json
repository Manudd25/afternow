{
  "name": "afternow-image-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-dev-vars.mjs",
    "dev": "dotenv -e ../.env -- sh -c 'export CLOUDFLARE_API_TOKEN=\"${CLOUDFLARE_API_TOKEN:-$CLOUDFARE_API_TOKEN}\"; export CLOUDFLARE_ACCOUNT_ID=\"${CLOUDFLARE_ACCOUNT_ID:-$CLOUDFARE_ACCOUNT_ID}\"; wrangler dev'",
    "predeploy": "node scripts/sync-dev-vars.mjs",
    "deploy": "dotenv -e ../.env -- sh -c 'export CLOUDFLARE_API_TOKEN=\"${CLOUDFLARE_API_TOKEN:-$CLOUDFARE_API_TOKEN}\"; export CLOUDFLARE_ACCOUNT_ID=\"${CLOUDFLARE_ACCOUNT_ID:-$CLOUDFARE_ACCOUNT_ID}\"; wrangler deploy'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.0"
  }
}
