# AfterNow — Environment Variables
# Copy this file to .env.local and fill in values as needed.
# These variables are read server-side by Vite only — they are NOT exposed to the browser.

# Image generation provider: "mock" (default) or "cloudflare"
AI_IMAGE_PROVIDER=mock

# Cloudflare Worker base URL (no trailing slash)
# Used by Vite dev/preview proxy — never sent to the browser bundle
AI_IMAGE_API_URL=

# Cloudflare account ID — required by Wrangler for Workers AI
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token — Wrangler (local Worker) OR Netlify Functions (production)
# ⚠️  Must be spelled CLOUDFLARE_API_TOKEN (double L in CLOUDFLARE)
# Needs Workers AI + Account permissions. Never prefix with VITE_.
CLOUDFLARE_API_TOKEN=

# --- Production (Netlify dashboard → Environment variables) ---
# Add the same CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN there.
# Scope: "Functions" (or "All") — they are server-side only, never in the browser bundle.

# Do NOT add API keys to the React frontend. Workers AI auth is handled by Wrangler + the [ai] binding.
